# Copy to .env.production on the dev server and fill in. Never commit the real file.
# Use the SAME random token in both *_TOKEN lines (e.g. `openssl rand -hex 24`).

# ── Baked into the extension at build time (npm run package) ──
VITE_SHARE_URL=http://<dev-server-ip-or-domain>:4747
VITE_SHARE_TOKEN=<team-upload-token>

# ── Read by the share server (pm2 / ecosystem.config.cjs) ──
CLAUDE_CLIP_PORT=4747
CLAUDE_CLIP_HOST=0.0.0.0
CLAUDE_CLIP_PUBLIC_URL=http://<dev-server-ip-or-domain>:4747
CLAUDE_CLIP_TOKEN=<team-upload-token>
CLAUDE_CLIP_DIR=/home/ubuntu/claude-clip-data
CLAUDE_CLIP_MAX_MB=200
