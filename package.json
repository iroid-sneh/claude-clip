{
  "name": "claude-clip",
  "version": "0.1.0",
  "description": "Record a bug on any site; Claude diagnoses it from one link. Captures video keyframes, network (with bodies), console, and errors via the Chrome DevTools Protocol.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mcp": "node --experimental-strip-types server/mcp.ts",
    "share": "node --experimental-strip-types server/share.ts",
    "demo": "node --experimental-strip-types server/demo.ts",
    "package": "npm run build && node --experimental-strip-types scripts/package.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.0",
    "perfect-freehand": "^1.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "roughjs": "^4.6.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  }
}
